{
  "name": "react-llm-markdown",
  "version": "0.1.0",
  "description": "Safe, rich Markdown for React and React Native, hardened for LLM output: GFM, streaming, code highlighting, math, Mermaid and ECharts. Includes a live-reload .md viewer CLI.",
  "license": "MIT",
  "homepage": "https://github.com/mickey-ichi/react-llm-markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickey-ichi/react-llm-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/mickey-ichi/react-llm-markdown/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mickey-ichi"
  },
  "keywords": [
    "react",
    "markdown",
    "llm",
    "ai",
    "streaming",
    "streamdown",
    "mermaid",
    "katex",
    "echarts",
    "shiki",
    "viewer",
    "cli",
    "sanitize",
    "react-native",
    "expo"
  ],
  "type": "module",
  "main": "./dist/web/index.js",
  "types": "./dist/web/index.d.ts",
  "react-native": "./dist/native/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "react-llm-markdown": "bin/react-llm-markdown.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.tsbuildinfo",
    "CHANGELOG.md",
    "LICENSE",
    "README*.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test --experimental-test-module-mocks --no-warnings=ExperimentalWarning \"test/*.test.ts\"",
    "prepack": "node scripts/build.mjs",
    "view": "node bin/react-llm-markdown.js",
    "e2e:web": "playwright test --project=web",
    "e2e:native": "node scripts/build-example.mjs && playwright test --project=native-web --project=webview",
    "e2e": "npm run e2e:native && npm run site && playwright test --project=web --project=site",
    "screenshots": "node scripts/build-example.mjs && node scripts/screenshots.mjs",
    "docs:report": "PLAYWRIGHT_JSON_OUTPUT_NAME=test-results/e2e.json playwright test --reporter=json,line --workers=2; node scripts/test-report.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@shikijs/engine-javascript": "^3.23.0",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "katex": "^0.19.1",
    "remark-cjk-friendly": "^2.3.4",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.3",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remend": "^1.4.0",
    "shiki": "^3.23.0",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "echarts": "^6.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.74",
    "react-native-webview": ">=13",
    "streamdown": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@shikijs/types": "^3.23.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/oxide": "^4.3.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "@streamdown/cjk": {
      "optional": true
    },
    "@streamdown/code": {
      "optional": true
    },
    "@streamdown/math": {
      "optional": true
    },
    "@streamdown/mermaid": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    },
    "streamdown": {
      "optional": true
    }
  }
}
